---
import Base from '../layouts/Base.astro';
import { getSingleImage, getNumberedImages } from '../utils/pageImages.js';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/index.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = (p) => localizePath(p, lang);

const hero = getSingleImage('hero');
const editorial = getSingleImage('start-editorial');
const events = getSingleImage('start-events');
const marken = getSingleImage('start-marken');
const straeusse = getSingleImage('start-straeusse');

const heroImgs = [marken, events, editorial, straeusse];
const leistungen = t.home.leistungen.map((l, i) => ({
  ...l,
  href: L(['/abo/', '/events/', '/events/szenografie/', '/angebot/straeusse/'][i]),
  img: heroImgs[i],
}));
---
<Base
  title={t.home.metaTitle}
  description={t.home.metaDescription}
  path="/"
>
  <!-- HERO: asymmetrisch, viel Leerraum -->
  <section class="v-hero">
    <div class="v-hero-type">
      <span class="v-eyebrow" data-reveal>{t.home.eyebrow}</span>
      <h1 data-reveal style="--reveal-delay:100ms">{t.home.h1_line1}<br>{t.home.h1_line2}<br><em>{t.home.h1_em}</em></h1>
    </div>
    {hero && (
      <figure class="v-hero-img" data-reveal style="--reveal-delay:220ms">
        <img src={hero} alt={t.home.heroAlt} loading="eager" />
      </figure>
    )}
  </section>

  <!-- LEERSTELLE: eine Aussage, viel Luft -->
  <section class="v-statement">
    <p data-reveal>{t.home.statement} <span>—</span> {t.home.statementEm}</p>
  </section>

  <!-- LEISTUNGEN: editoriale Liste statt Karten -->
  <section class="v-liste">
    <div class="v-inner">
      {leistungen.map((l, i) => (
        <a class="v-zeile" href={l.href} data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <span class="v-nr">{l.nr}</span>
          <span class="v-titel">{l.h}</span>
          <span class="v-text">{l.p}</span>
          <span class="v-pfeil">→</span>
          {l.img && <img class="v-hoverbild" src={l.img} alt="" aria-hidden="true" loading="lazy" />}
        </a>
      ))}
    </div>
  </section>

  <!-- GROSSES BILD: randlos, allein für sich -->
  {editorial && (
    <section class="v-vollbild" data-reveal>
      <img src={editorial} alt={t.home.vollbildAlt} loading="lazy" />
    </section>
  )}

  <!-- HALTUNG: versetzt, schmale Spalte -->
  <section class="v-haltung">
    <div class="v-haltung-copy" data-reveal>
      <p class="v-gross">{t.home.haltungGross}</p>
      <p>{t.home.haltungText}</p>
      <a class="v-link" href={L('/ueber-uns/')}>{t.home.haltungLink}</a>
    </div>
  </section>

  <!-- KONTAKT: minimal -->
  <section class="v-kontakt">
    <div class="v-inner">
      <h2 data-reveal>{t.home.kontaktH2_line1}<br>{t.home.kontaktH2_line2}</h2>
      <div class="v-kontakt-daten" data-reveal style="--reveal-delay:120ms">
        <a href="mailto:hello@lilac-bergamot.com">hello@lilac-bergamot.com</a>
        <a href="tel:+493062904677">+49 (0) 30 629 046 77</a>
        <a class="v-link" href={L('/kontakt/')}>{t.home.kontaktLink}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Grundhaltung: scharfe Kanten, keine Schatten, viel Luft ---- */
  .v-hero, .v-statement, .v-liste, .v-haltung, .v-kontakt { max-width: var(--maxw); margin-inline: auto; padding-inline: var(--gutter); }

  /* HERO */
  .v-hero {
    display: grid; grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 6vw, 6rem); align-items: end;
    padding-block: clamp(3rem, 9vw, 8rem) clamp(4rem, 10vw, 9rem);
  }
  .v-eyebrow {
    font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--malve); display: block; margin-bottom: 2.5rem;
  }
  .v-hero h1 {
    font-family: var(--serif); font-weight: 400;
    font-size: clamp(2.6rem, 7vw, 5.6rem); line-height: 1.02;
    letter-spacing: -0.02em; color: var(--pflaume);
  }
  .v-hero h1 em { font-style: italic; color: var(--malve); }
  .v-hero-img { margin: 0; }
  .v-hero-img img {
    width: 100%; height: auto; display: block;      /* scharfe Kanten, kein Radius, kein Beschnitt */
  }

  /* LEERSTELLE */
  .v-statement { padding-block: clamp(4rem, 12vw, 10rem); text-align: center; }
  .v-statement p {
    font-family: var(--serif); font-style: italic;
    font-size: clamp(1.4rem, 3.4vw, 2.6rem); line-height: 1.4;
    color: var(--pflaume); max-width: 24ch; margin-inline: auto;
  }
  .v-statement span { color: var(--malve); }

  /* LEISTUNGSLISTE */
  .v-liste { padding-block: 0 clamp(3rem, 8vw, 7rem); }
  .v-zeile {
    position: relative; display: grid;
    grid-template-columns: 4rem 1fr 1.4fr 2rem;
    gap: 1.5rem; align-items: baseline;
    padding-block: 1.9rem;
    border-top: 1px solid var(--linie-flieder);
    transition: padding-left 0.5s cubic-bezier(0.22,1,0.36,1);
  }
  .v-zeile:last-child { border-bottom: 1px solid var(--linie-flieder); }
  .v-nr { font-size: 0.72rem; letter-spacing: 0.2em; color: var(--malve); }
  .v-titel { font-family: var(--serif); font-size: clamp(1.4rem, 2.6vw, 2.1rem); color: var(--pflaume); }
  .v-text { color: var(--text-soft); font-size: 0.95rem; line-height: 1.6; }
  .v-pfeil { color: var(--malve); justify-self: end; transition: transform 0.4s ease; }
  .v-zeile:hover { padding-left: 1.2rem; z-index: 5; }
  .v-zeile:hover .v-pfeil { transform: translateX(6px); }
  /* Bild erscheint dezent beim Überfahren */
  .v-hoverbild {
    position: absolute; right: 6rem; top: 50%; transform: translateY(-50%) scale(0.96);
    width: 230px; height: 300px; object-fit: cover;
    opacity: 0; pointer-events: none; z-index: 4;
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.22,1,0.36,1);
  }
  .v-zeile:hover .v-hoverbild { opacity: 1; transform: translateY(-50%) scale(1); }

  /* VOLLBILD */
  .v-vollbild { margin-block: clamp(2rem, 6vw, 5rem); }
  .v-vollbild img { width: 100%; height: auto; display: block; }

  /* HALTUNG */
  .v-haltung { padding-block: clamp(4rem, 10vw, 8rem); display: grid; grid-template-columns: 1fr; }
  .v-haltung-copy { max-width: 46ch; margin-left: auto; }   /* bewusst nach rechts versetzt */
  .v-gross {
    font-family: var(--serif); font-style: italic;
    font-size: clamp(1.3rem, 2.6vw, 1.9rem); line-height: 1.4;
    color: var(--pflaume); margin-bottom: 1.6rem;
  }
  .v-haltung-copy p { color: var(--text-soft); line-height: 1.75; }
  .v-link {
    display: inline-block; margin-top: 1.8rem;
    font-size: 0.74rem; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--pflaume); border-bottom: 1px solid var(--malve); padding-bottom: 4px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .v-link:hover { color: var(--malve); border-color: var(--pflaume); }

  /* KONTAKT */
  .v-kontakt { padding-block: clamp(3rem, 8vw, 7rem) clamp(4rem, 10vw, 8rem); border-top: 1px solid var(--linie-flieder); }
  .v-kontakt .v-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-xl); align-items: start; }
  .v-kontakt h2 {
    font-family: var(--serif); font-weight: 400;
    font-size: clamp(1.9rem, 4.6vw, 3.4rem); line-height: 1.08; color: var(--pflaume);
  }
  .v-kontakt-daten { display: grid; gap: 0.7rem; align-content: start; }
  .v-kontakt-daten a { color: var(--text-soft); transition: color 0.3s ease; }
  .v-kontakt-daten a:hover { color: var(--pflaume); }

  @media (max-width: 860px) {
    .v-hero { grid-template-columns: 1fr; gap: 2rem; padding-block: 2rem 3rem; }
    .v-hero-img { order: -1; }
    .v-hero-img img { height: 56vh; }
    .v-eyebrow { margin-bottom: 1.2rem; }
    .v-zeile { grid-template-columns: 2.6rem 1fr; gap: 0.6rem 1rem; padding-block: 1.4rem; }
    .v-text { grid-column: 2; }
    .v-pfeil { display: none; }
    .v-hoverbild { display: none; }
    .v-haltung-copy { margin-left: 0; }
    .v-kontakt .v-inner { grid-template-columns: 1fr; gap: var(--sp-md); }
  }
</style>
