---
import Base from '../layouts/Base.astro';
import ContactForm from './ContactForm.astro';
import { getLangFromUrl, useTranslations } from '../i18n/index.js';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang).kontakt;
---
<Base title={t.metaTitle} description={t.metaDescription} path="/kontakt/">
  <section class="container contact-page">
    <div class="contact-copy" data-reveal>
      <span class="eyebrow">{t.eyebrow}</span>
      <h1>{t.h1}</h1>
      <p class="lead">{t.lead}</p>

      <dl class="details">
        <div><dt>{t.adresse}</dt><dd>Berliner Allee 121<br>13088 Berlin</dd></div>
        <div><dt>{t.telefon}</dt><dd><a href="tel:+493062904677">+49 (0) 30 629 046 77</a><br><a href="tel:+4917669118837">+49 (0) 17 669 118 837</a></dd></div>
        <div><dt>{t.email}</dt><dd><a href="mailto:hello@lilac-bergamot.com">hello@lilac-bergamot.com</a></dd></div>
        <div><dt>Instagram</dt><dd><a href="https://instagram.com/lilac_bergamot" class="ig-link"><svg class="ig-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg><span>@lilac_bergamot</span></a></dd></div>
      </dl>
    </div>

    <div class="form-wrap" data-reveal style="--reveal-delay:120ms">
      <ContactForm />
      <p class="form-note">{t.formNote}</p>
    </div>
  </section>
</Base>

<style>
  .contact-page { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-2xl); padding-block: var(--sp-lg) var(--sp-2xl); align-items: start; }
  .contact-copy h1 { font-size: clamp(2.3rem, 5.6vw, 4.2rem); line-height: 1.04; letter-spacing: -0.02em; font-weight: 400; margin: var(--sp-sm) 0 var(--sp-md); }
  .lead { font-size: 1.12rem; color: var(--text-soft); margin-bottom: var(--sp-lg); }
  .details { display: grid; gap: var(--sp-md); }
  .details dt { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-warm); font-weight: 600; margin-bottom: 0.35rem; }
  .details dd { color: var(--text); line-height: 1.7; }
  .details a { transition: color 0.3s ease; }
  .details a:hover { color: var(--accent); }
  .form-wrap { background: var(--bg-card); padding: var(--sp-lg); border-radius: var(--r-lg); box-shadow: var(--shadow-soft); }
  .form-note { font-size: 0.85rem; color: var(--text-muted); }
  @media (max-width: 860px) {
    .contact-page { grid-template-columns: 1fr; gap: var(--sp-lg); }
  }
  .ig-link { display: inline-flex; align-items: center; gap: 0.45rem; }
  .ig-icon { flex: none; }
</style>
