---
const links = [
  { href: '/ueber-uns/', label: 'Über uns' },
  { href: '/angebot/', label: 'Angebot' },
  { href: '/events/', label: 'Events' },
  { href: '/abo/', label: 'Abo & Preise' },
  { href: '/angebot/straeusse/', label: 'Sträuße' },
  { href: '/kontakt/', label: 'Kontakt' },
];
---
<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="logo"><img src="/logo/logo-schriftzug.svg" alt="Lilac & Bergamot" /></a>
    <nav class="nav-links" aria-label="Hauptnavigation">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <button class="nav-toggle" aria-label="Menü öffnen" aria-expanded="false"><span></span><span></span></button>
  </div>
  <div class="nav-backdrop" aria-hidden="true"></div>
</header>
<style>
  .nav { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--creme) 92%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid transparent; transition: border-color 0.4s ease; }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; padding-block: 1.25rem; position: relative; z-index: 60; }
  .logo { display: inline-flex; align-items: center; }
  .logo img { height: 40px; width: auto; display: block; }
  .nav-links { display: flex; gap: 1.9rem; }
  .nav-links a { position: relative; font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500; color: var(--text-soft); transition: color 0.3s ease; white-space: nowrap; }
  .nav-links a::after { content: ''; position: absolute; left: 0; bottom: -4px; width: 100%; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: right; transition: transform 0.4s cubic-bezier(0.22,1,0.36,1); }
  .nav-links a:hover { color: var(--text); }
  .nav-links a:hover::after { transform: scaleX(1); transform-origin: left; }
  .nav-toggle { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 6px; position: relative; z-index: 70; }
  .nav-toggle span { width: 24px; height: 2px; background: var(--pflaume); border-radius: 2px; transition: 0.3s; }
  .nav-backdrop { display: none; }

  @media (max-width: 900px) {
    .nav-toggle { display: flex; }
    /* Abdunkler hinter dem Menü */
    .nav-backdrop {
      display: block; position: fixed; inset: 0; z-index: 55;
      background: rgba(46, 20, 42, 0.45); backdrop-filter: blur(2px);
      opacity: 0; pointer-events: none; transition: opacity 0.4s ease;
    }
    .nav-backdrop.open { opacity: 1; pointer-events: auto; }

    /* Menü-Panel: kräftig Pflaume unterlegt, helle Schrift */
    .nav-links {
      position: fixed; top: 0; right: 0; height: 100vh; height: 100dvh; width: min(80vw, 340px);
      flex-direction: column; justify-content: flex-start; gap: 1.5rem;
      background: color-mix(in srgb, var(--pflaume) 82%, transparent);
      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      padding: 6rem 2.5rem; z-index: 60;
      transform: translateX(100%);
      transition: transform 0.5s cubic-bezier(0.22,1,0.36,1);
      box-shadow: -12px 0 40px -12px rgba(46,20,42,0.5);
    }
    .nav-links.open { transform: translateX(0); }
    .nav-links a {
      font-size: 1.05rem; letter-spacing: 0.1em;
      color: var(--limette);
    }
    .nav-links a::after { background: var(--limette); height: 1.5px; }
    .nav-links a:hover { color: #fff; }

    /* Hamburger -> X wenn offen */
    .nav-toggle.open span:first-child { transform: translateY(3.5px) rotate(45deg); }
    .nav-toggle.open span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  }
</style>
<script>
  const toggle = document.querySelector('.nav-toggle');
  const links = document.querySelector('.nav-links');
  const backdrop = document.querySelector('.nav-backdrop');
  function setOpen(open) {
    links?.classList.toggle('open', open);
    backdrop?.classList.toggle('open', open);
    toggle?.classList.toggle('open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    // Scrollen der Seite sperren, wenn Menü offen
    document.body.style.overflow = open ? 'hidden' : '';
  }
  toggle?.addEventListener('click', () => {
    setOpen(!links?.classList.contains('open'));
  });
  backdrop?.addEventListener('click', () => setOpen(false));
  // Menü schließen, wenn ein Link geklickt wird
  links?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
