---
import { getLangFromUrl, useTranslations, localizePath, alternatePath, languages } from '../i18n/index.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = (p) => localizePath(p, lang);

const links = [
  { href: L('/ueber-uns/'), label: t.nav.ueberUns },
  { href: L('/angebot/'), label: t.nav.angebot },
  { href: L('/events/'), label: t.nav.events },
  { href: L('/abo/'), label: t.nav.abo },
  { href: L('/angebot/straeusse/'), label: t.nav.straeusse },
  { href: L('/impressionen/'), label: t.nav.impressionen },
  { href: L('/kontakt/'), label: t.nav.kontakt },
];

// Sprachumschalter: Ziel-Pfade in beiden Sprachen
const langLinks = Object.keys(languages).map((code) => ({
  code,
  href: alternatePath(Astro.url, code),
  active: code === lang,
}));
---
<header class="nav">
  <div class="container nav-inner">
    <a href={L('/')} class="logo"><img src="/logo/logo-schriftzug.svg" alt="Lilac & Bergamot" /></a>
    <nav class="nav-links" aria-label="Hauptnavigation">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <span class="nav-lang" aria-label="Sprache wählen">
        {langLinks.map((ll, i) => (
          <>
            {i > 0 && <span class="nav-lang-sep">/</span>}
            <a href={ll.href} class={ll.active ? 'nav-lang-link active' : 'nav-lang-link'} hreflang={ll.code}>{ll.code.toUpperCase()}</a>
          </>
        ))}
      </span>
    </nav>
    <button class="nav-toggle" aria-label="Menü öffnen" aria-expanded="false"><span></span><span></span></button>
  </div>
  <div class="nav-backdrop" aria-hidden="true"></div>
</header>
<style>
  .nav { position: sticky; top: 0; z-index: 50; background: rgba(252,252,242,0.96); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border-bottom: 1px solid transparent; transition: border-color 0.4s ease; }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; padding-block: 0.6rem; position: relative; z-index: 60; }
  .logo { display: inline-flex; align-items: center; }
  .logo img { height: 92px; width: auto; display: block; }
  .nav-links { display: flex; gap: 1.9rem; }
  .nav-links a { position: relative; font-size: 0.82rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500; color: var(--text-soft); transition: color 0.3s ease; white-space: nowrap; }
  .nav-links a::after { content: ''; position: absolute; left: 0; bottom: -4px; width: 100%; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: right; transition: transform 0.4s cubic-bezier(0.22,1,0.36,1); }
  .nav-links a:hover { color: var(--text); }
  .nav-links a:hover::after { transform: scaleX(1); transform-origin: left; }
  .nav-toggle { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 6px; position: relative; z-index: 70; }
  .nav-toggle span { width: 24px; height: 2px; background: var(--pflaume); border-radius: 2px; transition: 0.3s; }
  .nav-backdrop { display: none; }

  /* Sprachumschalter */
  .nav-lang { display: inline-flex; align-items: center; gap: 0.4rem; margin-left: 0.6rem; }
  .nav-lang-sep { color: var(--n-200); font-size: 0.75rem; }
  .nav-lang-link {
    font-size: 0.78rem; letter-spacing: 0.1em; font-weight: 600;
    color: var(--text-muted); transition: color 0.3s ease;
  }
  .nav-lang-link.active { color: var(--accent); }
  .nav-lang-link:hover { color: var(--text); }
  .nav-lang-link::after { display: none; }

  @media (max-width: 1050px) {
    .nav-toggle { display: flex; }
    /* Abdunkler hinter dem Menü */
    .nav-backdrop {
      display: block; position: fixed; inset: 0; z-index: 55;
      background: rgba(46, 20, 42, 0.45); -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px);
      opacity: 0; pointer-events: none; transition: opacity 0.4s ease;
    }
    .nav-backdrop.open { opacity: 1; pointer-events: auto; }

    /* Menü-Panel: kräftig Pflaume unterlegt, helle Schrift */
    .nav-links {
      position: fixed; top: 0; right: 0; height: 100vh; height: 100dvh; width: min(80vw, 340px);
      flex-direction: column; justify-content: flex-start; gap: 1.5rem;
      background: rgba(86,28,76,0.82);
      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      padding: 6rem 2.5rem; z-index: 60;
      transform: translateX(100%);
      transition: transform 0.5s cubic-bezier(0.22,1,0.36,1);
      box-shadow: -12px 0 40px -12px rgba(46,20,42,0.5);
    }
    .nav-links.open { transform: translateX(0); }
    .nav-links a {
      font-size: 1.05rem; letter-spacing: 0.1em;
      color: var(--limette);
    }
    .nav-links a::after { background: var(--limette); height: 1.5px; }
    .nav-links a:hover { color: #fff; }
    /* Sprachumschalter im mobilen Menü */
    .nav-lang { margin-left: 0; margin-top: 1rem; gap: 0.6rem; }
    .nav-lang-sep { color: rgba(248,254,206,0.5); }
    .nav-lang-link { color: var(--limette); font-size: 0.95rem; }
    .nav-lang-link.active { color: #fff; text-decoration: underline; text-underline-offset: 4px; }

    /* Hamburger -> X wenn offen */
    .nav-toggle.open span:first-child { transform: translateY(3.5px) rotate(45deg); }
    .nav-toggle.open span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  }
</style>
<script>
  const toggle = document.querySelector('.nav-toggle');
  const links = document.querySelector('.nav-links');
  const backdrop = document.querySelector('.nav-backdrop');
  function setOpen(open) {
    links?.classList.toggle('open', open);
    backdrop?.classList.toggle('open', open);
    toggle?.classList.toggle('open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    // Scrollen der Seite sperren, wenn Menü offen
    document.body.style.overflow = open ? 'hidden' : '';
  }
  toggle?.addEventListener('click', () => {
    setOpen(!links?.classList.contains('open'));
  });
  backdrop?.addEventListener('click', () => setOpen(false));
  // Menü schließen, wenn ein Link geklickt wird
  links?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
