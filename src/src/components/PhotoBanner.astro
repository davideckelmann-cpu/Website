---
// Langsam durchlaufendes Foto-Banner (Endlosschleife)
// Findet die Bilder AUTOMATISCH: banner-1.jpg, banner-2.jpg, ... bis banner-24
// Einfach Dateien in public/images ablegen oder entfernen – fertig.
import { getNumberedImages } from '../utils/pageImages.js';

const { images = [], speed, height = "260px", base = "banner" } = Astro.props;

// Beschreibungen abwechselnd, damit keine Dubletten entstehen
const altTexte = [
  'Florales Arrangement von Lilac & Bergamot',
  'Event-Floristik in Berlin',
  'Florale Tafelgestaltung',
  'Detail einer floralen Komposition',
  'Handgebundener Strauß',
  'Saisonale Blumen aus Berlin',
];

// Automatisch gefundene Bilder, sofern keine manuell übergeben wurden
const gefunden = images.length > 0
  ? images
  : getNumberedImages(base).map((src, i) => ({ src, alt: altTexte[i % altTexte.length] }));

// Tempo bleibt gleich, egal wie viele Bilder: ca. 7 Sekunden pro Bild
const dauer = speed || Math.max(30, gefunden.length * 7);
// Für nahtlose Schleife: Bilder verdoppeln
// Erste Reihe: echte Bildbeschreibungen. Zweite Reihe: reine Deko für die
// nahtlose Endlosschleife -> aria-hidden + leeres alt (keine SEO-Dubletten).
const strip = [
  ...gefunden.map((img) => ({ ...img, decorative: false })),
  ...gefunden.map((img) => ({ ...img, decorative: true })),
];
---
<section class="banner" aria-label="Impressionen unserer Arbeit">
  <div class="banner-track" style={`--dur:${dauer}s`}>
    {strip.map((img) => (
      <figure class="banner-item" style={`--h:${height}`} aria-hidden={img.decorative ? "true" : undefined}>
        <img src={img.src} alt={img.decorative ? "" : (img.alt || "")} loading="lazy" onerror="this.closest('figure').style.display='none'" />
      </figure>
    ))}
  </div>
</section>

<style>
  .banner {
    overflow: hidden; width: 100%;
    padding-block: var(--sp-lg);
    /* weiche Ränder links/rechts */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .banner-track {
    display: flex; gap: var(--sp-sm); width: max-content;
    animation: slide var(--dur, 60s) linear infinite;
  }
  .banner:hover .banner-track { animation-play-state: paused; }
  .banner-item { flex: none; }
  .banner-item img {
    height: var(--h, 260px); width: auto; display: block;
    border-radius: var(--r-lg); box-shadow: var(--shadow-soft);
    object-fit: cover;
  }
  @keyframes slide {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }  /* halbe Strecke = eine Bildreihe */
  }
  @media (prefers-reduced-motion: reduce) {
    .banner-track { animation: none; }
    .banner { overflow-x: auto; }
  }
  @media (max-width: 700px) {
    .banner-item img { height: 180px; }
  }
</style>
