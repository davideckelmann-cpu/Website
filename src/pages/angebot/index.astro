---
import Base from '../../layouts/Base.astro';
import { getPageImages } from '../../utils/pageImages.js';
const bild = getPageImages('angebot');
import ContactCTA from '../../components/ContactCTA.astro';

const categories = [
  { h: 'Handgebundene Sträuße', p: 'Saisonale Sträuße als Geschenk oder für Zuhause – ab 35 €.', href: '/angebot/straeusse/' },
  { h: 'Salons', p: 'Für Friseursalons, Beauty-Studios & Concept Stores.', href: '/angebot/salons/' },
  { h: 'Gastronomie', p: 'Für Restaurants, Cafés, Bars und Hotels.', href: '/angebot/gastronomie/' },
  { h: 'Galerien', p: 'Zurückhaltende Floristik im Dialog mit der Kunst.', href: '/angebot/galerien/' },
  { h: 'Praxen', p: 'Für Empfangsbereiche und Wartezimmer.', href: '/angebot/praxen/' },
  { h: 'Kanzleien', p: 'Repräsentative Blumen für Empfang & Besprechung.', href: '/angebot/kanzleien/' },
  { h: 'Editorials', p: 'Florale Gestaltung für Shootings & Produktionen.', href: '/angebot/editorials/' },
  { h: 'Blumen-Abo', p: 'Frische Arrangements für Geschäftsräume – wöchentlich geliefert.', href: '/abo/' },
];
---
<Base title="Angebot — Lilac & Bergamot, Floristik in Berlin" description="Unser florales Angebot in Berlin: Sträuße, Blumen-Abos und Arrangements für Salons, Gastronomie, Galerien, Praxen und Kanzleien." path="/angebot/">
  <section class="ed-head">
    <span class="eyebrow" data-reveal>Unser Angebot</span>
    <h1 data-reveal style="--reveal-delay:80ms">Florale Gestaltung für Räume, Menschen und Momente</h1>
    <p class="lead" data-reveal style="--reveal-delay:160ms">Für Salons, Gastronomie, Galerien, Praxen und Kanzleien – und für private Anlässe. Feinsinnig, saisonal, lebendig.</p>
  </section>

  {bild.mode === 'set' && (
    <section class="container page-media-set" data-reveal>
      {bild.images.map((src, i) => (
        <img src={src} alt={`Florale Gestaltung – Impression ${i + 1}`} loading="lazy"
          onerror="this.style.display='none'" />
      ))}
    </section>
  )}
  {bild.mode === 'single' && (
    <section class="container page-media" data-reveal>
      <img src={bild.image} alt="Florale Gestaltung von Lilac & Bergamot" loading="lazy"
        onerror="this.closest('section').style.display='none'" />
    </section>
  )}

  <section class="ed-statement" data-reveal>
    <p>Für jeden Ort <span>—</span> die passende Geste.</p>
  </section>

  <section class="container list">
    {categories.map((c, i) => (
      <a class="row" href={c.href} data-reveal style={`--reveal-delay:${(i%4)*70}ms`}>
        <div><h3>{c.h}</h3><p>{c.p}</p></div>
        <span class="arrow">→</span>
      </a>
    ))}
  </section>
  <ContactCTA />
</Base>
<style>
  .page-media { padding-bottom: var(--sp-lg); }
  .page-media img { width: 100%; height: clamp(260px, 38vw, 440px); object-fit: contain; background: var(--bg-alt); display: block; }
  .page-media-set { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: var(--sp-sm); padding-bottom: var(--sp-lg); }
  .page-media-set img { width: 100%; height: clamp(320px, 42vw, 520px); object-fit: contain; background: var(--bg-alt); display: block; }
  @media (max-width: 760px) {
    .page-media-set { grid-auto-flow: row; grid-auto-columns: auto; }
    .page-media-set img { height: auto; max-height: 60vh; }
    .page-media img { height: auto; max-height: 60vh; }
  }

  .list { display: grid; gap: 0; padding-bottom: var(--sp-2xl); max-width: 820px; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-md); padding: var(--sp-md) 0; border-bottom: 1px solid var(--linie-flieder); transition: padding-left 0.4s cubic-bezier(.22,1,.36,1); }
  .row:first-child { border-top: 1px solid var(--linie-flieder); }
  .row:hover { padding-left: 1rem; }
  .row h3 { font-family: var(--serif); font-weight: 400; font-size: 1.5rem; margin-bottom: 0.2rem; color: var(--pflaume); }
  .row p { color: var(--text-soft); font-size: 0.95rem; }
  .arrow { color: var(--accent); font-size: 1.5rem; transition: transform 0.4s cubic-bezier(.22,1,.36,1); }
  .row:hover .arrow { transform: translateX(6px); }
</style>
