---
import Base from '../layouts/Base.astro';
import ContactCTA from '../components/ContactCTA.astro';

// Gallery — reuse available photos for now; add real ones later
const gallery = [
  { src: '/images/impressionen-1.jpg', alt: 'Arrangement mit Flieder und Bergamotte', tall: true },
  { src: '/images/impressionen-2.jpg', alt: 'Florale Tafel für das Caudalie-Event' },
  { src: '/images/impressionen-3.jpg', alt: 'Florale Gestaltung einer Tafel' },
  { src: '/images/impressionen-4.jpg', alt: 'Florales Detail mit Kerzen', tall: true },
  { src: '/images/impressionen-5.jpg', alt: 'Handgebundener Strauß' },
  { src: '/images/impressionen-6.jpg', alt: 'Event-Floristik in Berlin' },
];
---
<Base
  title="Impressionen — Lilac & Bergamot, Floristik in Berlin"
  description="Impressionen unserer floralen Arbeiten in Berlin: Arrangements, Event-Floristik, Sträuße und Installationen. Ein Eindruck von Stil und Atmosphäre."
  path="/impressionen/"
>
  <section class="container page-head">
    <span class="eyebrow" data-reveal>Impressionen</span>
    <h1 data-reveal style="--reveal-delay:80ms">Ein Eindruck unserer Arbeit</h1>
    <p class="lead" data-reveal style="--reveal-delay:160ms">
      Eine Auswahl unserer floralen Gestaltungen – von handgebundenen Sträußen über Event-Floristik
      bis zu Installationen. Sie vermitteln einen Eindruck von Stil, Größe und Atmosphäre.
    </p>
  </section>

  <section class="container gallery">
    {gallery.map((img, i) => (
      <figure class={`tile ${img.tall ? 'tall' : ''}`} data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
        <img src={img.src} alt={img.alt} loading="lazy" />
      </figure>
    ))}
  </section>

  <ContactCTA />
</Base>

<style>
  .page-head { padding-block: var(--sp-2xl) var(--sp-lg); }
  .page-head h1 { font-size: clamp(2.7rem, 6vw, 4.3rem); margin: var(--sp-sm) 0 var(--sp-md); }
  .lead { font-size: 1.15rem; color: var(--text-soft); max-width: 60ch; }

  .gallery {
    columns: 3; column-gap: var(--sp-md); padding-bottom: var(--sp-2xl);
  }
  .tile {
    break-inside: avoid; margin-bottom: var(--sp-md);
    border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-soft);
  }
  .tile img {
    width: 100%; height: auto; display: block;
    transition: transform 0.8s cubic-bezier(0.22,1,0.36,1);
  }
  .tile:hover img { transform: scale(1.05); }
  .tile.tall img { aspect-ratio: 3/4; object-fit: cover; }

  @media (max-width: 900px) { .gallery { columns: 2; } }
  @media (max-width: 560px) { .gallery { columns: 1; } }
</style>
