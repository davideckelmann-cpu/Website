---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
---
<Base
  title="Kontakt — Lilac & Bergamot, Floristik in Berlin"
  description="Kontakt zu Lilac & Bergamot, Floristik in Berlin. Florale Kompositionen, Events oder Zusammenarbeit anfragen. Berliner Allee 121 · hello@lilac-bergamot.com."
  path="/kontakt/"
>
  <section class="container contact-page">
    <div class="contact-copy" data-reveal>
      <span class="eyebrow">Kontakt</span>
      <h1>Erzählen Sie uns von Ihrer Idee.</h1>
      <p class="lead">Sie möchten eine florale Komposition anfragen, einen besonderen Anlass
        gestalten lassen oder haben eine Idee für eine Zusammenarbeit? Wir freuen uns auf Ihre
        Nachricht.</p>

      <dl class="details">
        <div><dt>Adresse</dt><dd>Berliner Allee 121<br>13088 Berlin</dd></div>
        <div><dt>Telefon</dt><dd><a href="tel:+493062904677">+49 (0) 30 629 046 77</a><br><a href="tel:+4917669118837">+49 (0) 17 669 118 837</a></dd></div>
        <div><dt>E-Mail</dt><dd><a href="mailto:hello@lilac-bergamot.com">hello@lilac-bergamot.com</a></dd></div>
        <div><dt>Instagram</dt><dd><a href="https://instagram.com/lilac_bergamot">@lilac_bergamot</a></dd></div>
      </dl>
    </div>

    <div class="form-wrap" data-reveal style="--reveal-delay:120ms">
      <ContactForm />
      <p class="form-note">Wir melden uns so schnell wie möglich bei Ihnen zurück.</p>
    </div>
  </section>
</Base>

<style>
  .contact-page { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-2xl); padding-block: var(--sp-2xl); align-items: start; }
  .contact-copy h1 { font-size: clamp(2.2rem, 5vw, 3.2rem); margin: var(--sp-sm) 0 var(--sp-md); }
  .lead { font-size: 1.12rem; color: var(--text-soft); margin-bottom: var(--sp-lg); }

  .details { display: grid; gap: var(--sp-md); }
  .details dt { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-warm); font-weight: 600; margin-bottom: 0.35rem; }
  .details dd { color: var(--text); line-height: 1.7; }
  .details a { transition: color 0.3s ease; }
  .details a:hover { color: var(--accent); }

  .form-wrap { background: var(--bg-card); padding: var(--sp-lg); border-radius: var(--r-lg); box-shadow: var(--shadow-soft); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-sm); }
  .field { padding: 1rem 1.25rem; border-radius: var(--r-md); background: var(--bg); border: 1px solid var(--n-200); font-family: var(--sans); font-size: 1rem; color: var(--text); transition: border-color 0.3s ease, box-shadow 0.3s ease; }
  .field::placeholder { color: var(--text-muted); }
  .field:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent); }
  .form .btn { align-self: flex-start; margin-top: 0.25rem; }
  .form-note { font-size: 0.85rem; color: var(--text-muted); }

  @media (max-width: 860px) {
    .contact-page { grid-template-columns: 1fr; gap: var(--sp-lg); }
    .form .btn { align-self: stretch; text-align: center; }
  }
</style>
