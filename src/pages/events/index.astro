---
import Base from '../../layouts/Base.astro';
import { getPageImages } from '../../utils/pageImages.js';
const bild = getPageImages('events');
import ContactCTA from '../../components/ContactCTA.astro';

const categories = [
  { h: 'Firmenevents', p: 'Florale Gestaltung für Konferenzen, Feiern und Corporate-Anlässe.', href: '/events/firmenevents/' },
  { h: 'Markenpräsentationen', p: 'Florale Szenografie für Launches & Pop-ups – wie für Caudalie.', href: '/events/markenpraesentation/' },
  { h: 'Hochzeiten', p: 'Vom Brautstrauß bis zur Tischdekoration.', href: '/events/hochzeiten/' },
  { h: 'Szenografie', p: 'Großflächige Installationen und Rauminszenierung.', href: '/events/szenografie/' },
  { h: 'Trauerfloristik', p: 'Einfühlsam gestaltete Kränze, Gestecke und Abschiedsblumen.', href: '/events/trauerfloristik/' },
  { h: 'Private Anlässe', p: 'Florale Gestaltung für Geburtstage, Jubiläen und Feste.', href: '/events/private-anlaesse/' },
];
---
<Base title="Events & Hochzeiten — Lilac & Bergamot, Floristik in Berlin" description="Event-Floristik in Berlin: Hochzeiten, Firmenevents, Markenpräsentationen, Szenografie und Trauerfloristik. Florale Gestaltung mit Seele." path="/events/">
  <section class="container page-head">
    <span class="eyebrow" data-reveal>Events</span>
    <h1 data-reveal style="--reveal-delay:80ms">Jeder Anlass erzählt eine eigene Geschichte</h1>
    <p class="lead" data-reveal style="--reveal-delay:160ms">Ob intime Trauung, große Feier oder Markenpräsentation: Wir kreieren florale Gestaltung, die den Moment begleitet – authentisch, ästhetisch, persönlich.</p>
  </section>

  {bild.mode === 'set' && (
    <section class="container page-media-set" data-reveal>
      {bild.images.map((src, i) => (
        <figure><img src={src} alt={`Florale Gestaltung – Impression ${i + 1}`} loading="lazy"
          onerror="this.closest('figure').style.display='none'" /></figure>
      ))}
    </section>
  )}
  {bild.mode === 'single' && (
    <section class="container page-media" data-reveal>
      <img src={bild.image} alt="Florale Gestaltung von Lilac & Bergamot" loading="lazy"
        onerror="this.closest('section').style.display='none'" />
    </section>
  )}
  <section class="container list">
    {categories.map((c, i) => (
      <a class="row" href={c.href} data-reveal style={`--reveal-delay:${(i%4)*70}ms`}>
        <div><h3>{c.h}</h3><p>{c.p}</p></div>
        <span class="arrow">→</span>
      </a>
    ))}
  </section>
  <ContactCTA />
</Base>
<style>
  .page-media { padding-bottom: var(--sp-lg); }
  .page-media img { width: 100%; height: clamp(260px, 38vw, 440px); object-fit: cover; border-radius: var(--r-lg); box-shadow: var(--shadow-card); display: block; }
  .page-media-set { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: var(--sp-sm); padding-bottom: var(--sp-lg); }
  .page-media-set img { width: 100%; height: clamp(320px, 42vw, 520px); object-fit: cover; border-radius: var(--r-lg); box-shadow: var(--shadow-card); display: block; }
  @media (max-width: 760px) {
    .page-media-set { grid-auto-flow: row; grid-auto-columns: auto; }
    .page-media-set img { height: auto; max-height: 60vh; object-fit: contain; background: var(--bg-alt); }
    .page-media img { height: auto; max-height: 60vh; object-fit: contain; background: var(--bg-alt); }
  }

  .page-head { padding-block: var(--sp-2xl) var(--sp-lg); }
  .page-head h1 { font-size: clamp(2.1rem, 5vw, 3.8rem); line-height: 1.05; letter-spacing: -0.015em; font-weight: 400; margin: var(--sp-sm) 0 var(--sp-md); max-width: 20ch; }
  .lead { font-size: 1.15rem; color: var(--text-soft); max-width: 58ch; }
  .list { display: grid; gap: 0; padding-bottom: var(--sp-2xl); max-width: 820px; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-md); padding: var(--sp-md) 0; border-bottom: 1px solid var(--n-200); transition: padding-left 0.4s cubic-bezier(.22,1,.36,1); }
  .row:hover { padding-left: 1rem; }
  .row h3 { font-size: 1.5rem; margin-bottom: 0.2rem; }
  .row p { color: var(--text-soft); font-size: 0.95rem; }
  .arrow { color: var(--accent); font-size: 1.5rem; transition: transform 0.4s cubic-bezier(.22,1,.36,1); }
  .row:hover .arrow { transform: translateX(6px); }
</style>
