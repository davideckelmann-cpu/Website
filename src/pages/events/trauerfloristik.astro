---
import Base from '../../layouts/Base.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { getPageImages } from '../../utils/pageImages.js';

const bild = getPageImages('trauerfloristik');

const services = [
  { h: 'Blumenkränze & Gestecke', p: 'Klassisch, modern oder naturnah – auf Wunsch mit Symbolblumen wie Lilien, Calla, Rosen oder Efeu.' },
  { h: 'Urnen- und Sargschmuck', p: 'Schlichte Blumenbänder oder aufwändig gestaltete Umrahmungen für die Zeremonie.' },
  { h: 'Kondolenzsträuße & Abschiedsblumen', p: 'Als Geste der Anteilnahme oder zur persönlichen Verabschiedung am Grab.' },
  { h: 'Lieferung & Aufstellung in Berlin', p: 'Pünktlich zum Ort der Trauerfeier oder zum Friedhof.' },
  { h: 'Beratung mit Feingefühl', p: 'In einem persönlichen Gespräch klären wir Blüten, Farben und Gestaltung – auch kurzfristig.' },
];

const faq = [
  { q: 'Welche Blumen sind für eine Trauerfeier geeignet?', a: 'Blumen mit Symbolcharakter wie Lilien, Calla, Nelken oder Rosen in gedeckten Farben sind üblich – wir beraten Sie gerne.' },
  { q: 'Ist auch eine dezente, moderne Gestaltung möglich?', a: 'Ja. Wir bieten auch naturnahe, reduzierte oder saisonale Konzepte – passend zur Persönlichkeit des Verstorbenen.' },
  { q: 'Wann sollte ich bestellen?', a: 'Gerne so früh wie möglich – in Notfällen sind auch kurzfristige Aufträge möglich.' },
];
---
<Base
  title="Trauerfloristik Berlin — Lilac & Bergamot"
  description="Stilvolle, einfühlsame Floristik für Trauerfeiern in Berlin. Individuelle Blumenarrangements, die Abschied & Erinnerung würdevoll begleiten."
  path="/events/trauerfloristik/"
>
  <section class="ed-head">
    <img src="/icons/icon-calla-herz.png" alt="" class="page-icon" data-reveal width="120" height="150" loading="lazy" />
    <span class="eyebrow" data-reveal><a href="/events/">Events</a> · Trauer</span>
    <h1 data-reveal style="--reveal-delay:80ms">Florale Zeichen des Gedenkens</h1>
    <p class="lead" data-reveal style="--reveal-delay:160ms">
      Blumen sagen oft mehr als Worte – besonders, wenn es um Abschied geht. In dieser stillen
      Zeit begleiten wir Sie mit einfühlsam gestalteter Trauerfloristik, die Erinnerungen ehrt
      und Trost spendet.
    </p>
  </section>

  {bild.mode === 'set' && (
    <section class="container ed-media-set" data-reveal>
      {bild.images.map((src, i) => (
        <img src={src} alt={`Trauerfloristik in Berlin – Beispiel ${i + 1}`} loading="lazy" onerror="this.style.display='none'" />
      ))}
    </section>
  )}
  {bild.mode === 'single' && (
    <section class="container ed-media" data-reveal>
      <img src={bild.image} alt="Trauerfloristik in Berlin von Lilac & Bergamot" loading="lazy" onerror="this.closest('section').style.display='none'" />
    </section>
  )}

  <section class="container services">
    <h2 data-reveal>Für Abschied und Erinnerung</h2>
    <div class="svc-rows">
      {services.map((s, i) => (
        <article class="svc-row" data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
          <h3>{s.h}</h3>
          <p>{s.p}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="meaning">
    <div class="container meaning-inner" data-reveal>
      <h2>Blumen mit Bedeutung</h2>
      <p>Welche Blume passt zum Abschied eines geliebten Menschen? Weiße Lilien stehen für Reinheit,
        Calla für Würde, Rosen für Liebe. Wir helfen Ihnen bei der Auswahl und gestalten florale
        Erinnerungen, die wirken – zurückhaltend, stark oder ganz individuell. Auch persönliche
        Gegenstände oder handgeschriebene Kärtchen lassen sich einfügen.</p>
    </div>
  </section>

  <section class="container faq">
    <h2 data-reveal>Häufige Fragen</h2>
    <div class="faq-list">
      {faq.map((f, i) => (
        <details class="faq-item" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p class="note" data-reveal>
      Die Preise richten sich nach Aufwand, Blütenwahl und Größe des Arrangements. Wir kalkulieren
      transparent und beraten Sie persönlich. Trauerfloristik ist auch im Abo möglich, etwa zur
      Grabgestaltung oder für regelmäßige Gedenktage.
    </p>
  </section>

  <ContactCTA />
</Base>

<style>
  .page-icon { width: 88px; height: auto; margin-bottom: var(--sp-sm); }

  .services { padding-block: var(--sp-lg) var(--sp-2xl); }
  .services > h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(1.8rem, 3.6vw, 2.5rem); margin-bottom: var(--sp-lg); }
  .svc-rows { border-top: 1px solid var(--linie-flieder); }
  .svc-row { padding-block: 1.5rem; border-bottom: 1px solid var(--linie-flieder); }
  .svc-row h3 { font-family: var(--serif); font-weight: 400; font-size: 1.3rem; color: var(--pflaume); margin-bottom: 0.35rem; }
  .svc-row p { font-size: 0.98rem; color: var(--text-soft); }

  .meaning { background: var(--bg-alt); padding-block: var(--sp-2xl); }
  .meaning-inner { max-width: 72ch; }
  .meaning h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(1.8rem, 3.6vw, 2.5rem); margin-bottom: var(--sp-md); }
  .meaning p { font-size: 1.08rem; color: var(--text-soft); }

  .faq { padding-block: var(--sp-2xl); }
  .faq > h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(1.8rem, 3.6vw, 2.5rem); margin-bottom: var(--sp-lg); }
  .faq-list { display: grid; max-width: 76ch; border-top: 1px solid var(--linie-flieder); }
  .faq-item { border-bottom: 1px solid var(--linie-flieder); padding: 0; background: transparent; }
  .faq-item summary { padding: 1.3rem 0; cursor: pointer; font-family: var(--serif); font-size: 1.15rem; color: var(--pflaume); list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .faq-item summary::after { content: '+'; color: var(--accent); font-size: 1.3rem; transition: transform 0.3s ease; }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p { padding: 0 0 1.3rem; color: var(--text-soft); }
  .note { margin-top: var(--sp-lg); color: var(--text-soft); max-width: 72ch; }
</style>
