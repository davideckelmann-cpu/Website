---
import Base from '../layouts/Base.astro';
import ContactCTA from '../components/ContactCTA.astro';

const models = [
  { name: 'Basic', desc: 'Ein zarter Akzent für kleine Räume oder den Empfang. Kleiner Strauß / Vase', rhythm: '1× pro Woche', price: 'ab 155 €', img: '/images/ueber-uns-2.jpg' },
  { name: 'Standard', desc: 'Ein ausgewogener Strauß, der Atmosphäre schafft. Strauß / Vase', rhythm: '1× pro Woche', price: 'ab 235 €', img: '/images/ueber-uns-3.jpg' },
  { name: 'Flex', desc: 'Für mehr Präsenz – individuell auf den Raum abgestimmt. Strauß / Vase', rhythm: '1× alle zwei Wochen', price: 'ab 135 €', img: '/images/ueber-uns-5.jpg' },
  { name: 'Gallery', desc: 'Großzügig, wirkungsvoll – ein Statement im Raum. Strauß / Vase', rhythm: '1× alle zwei Wochen', price: 'ab 195 €', img: '/images/ueber-uns-6.jpg' },
];

const benefits = [
  'Regelmäßig Atmosphäre & Stil',
  'Kein Planen, kein Einkaufen',
  'Immer besonders: Sie entscheiden den Rhythmus',
  'Zuverlässig direkt in Ihre Räume geliefert',
  'Mit passendem Gefäß auf Wunsch',
  'Im Einklang mit Raum, Stimmung und Menschen',
  'Persönliche Beratung inklusive',
];
---
<Base
  title="Blumen-Abo Berlin für Geschäftskunden — Lilac & Bergamot"
  description="Für Geschäftsräume und Privathaushalte bieten wir individuelle Blumen-Abos und florale Designs – saisonal, handgebunden und auf Ihre Räume abgestimmt."
  path="/abo/"
>
  <section class="ed-head">
    <span class="eyebrow" data-reveal>Abo &amp; Preise</span>
    <h1 data-reveal style="--reveal-delay:80ms">Blumen-Abo in Berlin für Geschäftskunden</h1>
    <p class="lead" data-reveal style="--reveal-delay:160ms">
      Für Geschäftsräume und Privathaushalte bieten wir individuelle Blumen-Abos und florale
      Designs – saisonal, handgebunden und auf Ihre Räume abgestimmt.
    </p>
  </section>

  <section class="ed-statement" data-reveal>
    <p>Blumen, die bleiben <span>—</span> im Gefühl, nicht nur im Raum.</p>
  </section>

  <section class="container split">
    <div data-reveal>
      <p>Ein Strauß als Begleitung – zum Feiern, Verschenken, den Alltag verwandeln und eigene
        Blumen-Rituale genießen. Unsere Blumen sprechen von Wertschätzung, Stil und feiner
        Aufmerksamkeit. Saisonal, regional, bewusst.</p>
    </div>
    <ul class="benefits" data-reveal style="--reveal-delay:120ms">
      {benefits.map((b) => <li>{b}</li>)}
    </ul>
  </section>

  <section class="container models">
    <h2 data-reveal>Unsere Abo-Modelle</h2>
    <div class="model-rows">
      {models.map((m, i) => (
        <article class="model-row" data-reveal style={`--reveal-delay:${(i % 4) * 90}ms`}>
          {m.img && <img class="model-img" src={m.img} alt={`Beispiel für das Abo-Modell ${m.name}`} width="300" height="220" loading="lazy" />}
          <div class="model-copy">
            <div class="model-top">
              <h3>{m.name}</h3>
              <span class="price">{m.price}</span>
            </div>
            <p>{m.desc}</p>
            <span class="rhythm">{m.rhythm}</span>
          </div>
        </article>
      ))}
    </div>
    <p class="note" data-reveal>
      Wir liefern wöchentlich und nach Bedarf frische Sträuße und Bouquets – abgestimmt auf Ihre
      Geschäftsräume, Wünsche und Vorlieben. Von Hand gestaltet und direkt zu Ihnen gebracht, in
      Berlin. Wir beraten Sie gerne individuell zu Ihrem persönlichen Modell.
    </p>
  </section>

  <ContactCTA />
</Base>

<style>
  .split { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--sp-xl); align-items: center; padding-block: var(--sp-lg) var(--sp-2xl); }
  .split p { color: var(--text-soft); font-size: 1.08rem; }
  .benefits { list-style: none; display: grid; gap: 0.75rem; }
  .benefits li { position: relative; padding-left: 1.6rem; color: var(--text); }
  .benefits li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }

  .models { padding-bottom: var(--sp-2xl); }
  .models > h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(1.8rem, 3.6vw, 2.5rem); margin-bottom: var(--sp-lg); }

  /* Editoriale Zeilen statt Tabelle */
  .model-rows { border-top: 1px solid var(--linie-flieder); }
  .model-row {
    display: grid; grid-template-columns: 220px 1fr; gap: var(--sp-lg); align-items: center;
    padding-block: clamp(1.6rem, 3vw, 2.2rem); border-bottom: 1px solid var(--linie-flieder);
  }
  .model-img { width: 100%; height: 150px; object-fit: contain; background: var(--bg-alt); display: block; }
  .model-top { display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.5rem; }
  .model-row h3 { font-family: var(--serif); font-weight: 400; font-size: 1.5rem; color: var(--pflaume); }
  .model-row .price { font-family: var(--serif); font-weight: 500; font-size: 1.2rem; color: var(--accent); white-space: nowrap; }
  .model-row p { font-size: 0.98rem; color: var(--text-soft); }
  .rhythm { display: inline-block; margin-top: 0.6rem; font-size: 0.8rem; color: var(--text-muted); font-style: italic; }
  .note { margin-top: var(--sp-lg); color: var(--text-soft); max-width: 70ch; }

  @media (max-width: 860px) { .split { grid-template-columns: 1fr; gap: var(--sp-lg); } }
  @media (max-width: 640px) {
    .model-row { grid-template-columns: 1fr; gap: 0.9rem; }
    .model-img { height: 190px; }
  }
</style>
